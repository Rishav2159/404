# OpenRouter API key (free tier available at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the free models used for each mode
OPENROUTER_MODEL_QUALITY=openrouter/free
OPENROUTER_MODEL_FAST=openrouter/free

# Optional: site URL for OpenRouter rankings/attribution
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: EmailJS (contact form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_USER_ID=
